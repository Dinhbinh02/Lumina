{
    "manifest_version":  3,
    "name":  "Lumina",
    "version":  "1.0",
    "description":  "Fast, private, and flexible AI assistant for your browser.",
    "content_security_policy":  {
                                    "extension_pages":  "script-src \u0027self\u0027 \u0027wasm-unsafe-eval\u0027; style-src \u0027self\u0027 \u0027unsafe-inline\u0027 https://fonts.googleapis.com; font-src \u0027self\u0027 https://fonts.gstatic.com; object-src \u0027self\u0027"
                                },
    "permissions":  [
                        "storage",
                        "unlimitedStorage",
                        "activeTab",
                        "scripting",
                        "webNavigation",
                        "offscreen",
                        "system.display",
                        "alarms",
                        "identity",
                        "tts",
                        "clipboardWrite",
                        "cookies",
                        "declarativeNetRequest",
                        "declarativeNetRequestWithHostAccess",
                        "sidePanel"
                    ],
    "declarative_net_request":  {
                                    "rule_resources":  [
                                                           {
                                                               "id":  "ruleset_1",
                                                               "enabled":  true,
                                                               "path":  "rules.json"
                                                           }
                                                       ]
                                },
    "host_permissions":  [
                             "\u003call_urls\u003e",
                             "https://tactiq.io/*"
                         ],
    "icons":  {
                  "16":  "assets/icons/icon16.png",
                  "32":  "assets/icons/icon32.png",
                  "48":  "assets/icons/icon48.png",
                  "128":  "assets/icons/icon128.png"
              },
    "action":  {
                   "default_icon":  {
                                        "16":  "assets/icons/icon16.png",
                                        "32":  "assets/icons/icon32.png",
                                        "48":  "assets/icons/icon48.png",
                                        "128":  "assets/icons/icon128.png"
                                    },
                   "default_title":  "Lumina",
                   "default_popup":  "pages/popup/popup.html"
               },
    "background":  {
                       "service_worker":  "scripts/background.bundle.js",
                       "type":  "module"
                   },
    "commands":  {
                     "open-lumina-chat":  {
                                              "suggested_key":  {
                                                                    "default":  "Ctrl+Space",
                                                                    "mac":  "Alt+Space"
                                                                },
                                              "description":  "Toggle Lumina Window",
                                              "global":  true
                                          },
                     "new-chat":  {
                                      "suggested_key":  {
                                                            "default":  "Ctrl+Shift+L",
                                                            "mac":  "Command+Shift+L"
                                                        },
                                      "description":  "Start a new conversation",
                                      "global":  true
                                  },
                     "toggle-side-panel":  {
                                               "suggested_key":  {
                                                                     "default":  "Ctrl+Shift+Y",
                                                                     "mac":  "Command+Shift+Y"
                                                                 },
                                               "description":  "Toggle Lumina Side Panel",
                                               "global":  true
                                           }
                 },
    "web_accessible_resources":  [
                                     {
                                         "resources":  [
                                                           "lib/vendor/*",
                                                           "lib/parsers/*",
                                                           "assets/*",
                                                           "assets/audio/*",
                                                           "assets/styles/*",
                                                           "lib/vendor/katex/*",
                                                           "scripts/*",
                                                           "pages/*"
                                                       ],
                                         "matches":  [
                                                         "\u003call_urls\u003e"
                                                     ]
                                     }
                                 ],
    "options_ui":  {
                       "page":  "pages/lumina/lumina.html?settings=1",
                       "open_in_tab":  true
                   },
    "content_scripts":  [
                            {
                                "matches":  [
                                                "http://*/*",
                                                "https://*/*"
                                            ],
                                "js":  [
                                           "scripts/content.bundle.js"
                                       ],
                                "run_at":  "document_end",
                                "all_frames":  true
                            }
                        ],
    "oauth2":  {
                   "client_id":  "824888142961-2dgilgui2bq6rqe4hv5fo7pjktq27h0m.apps.googleusercontent.com",
                   "scopes":  [
                                  "https://www.googleapis.com/auth/userinfo.email",
                                  "https://www.googleapis.com/auth/userinfo.profile",
                                  "https://www.googleapis.com/auth/drive.appdata"
                              ]
               },
    "key":  ""
}
